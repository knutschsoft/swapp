{
    "include": [
        "./assets/**/*.d.ts",
        "./assets/**/*.ts",
        "./assets/**/*.vue",
    ],
    "compilerOptions": {
        "target": "es2015", // pretty defensive setting for older browsers
        "module": "es2022",
        "moduleResolution": "Node",
        "isolatedModules": true,
        "strict": true, // use 'strict'; e.g.
        "noImplicitAny": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "paths": {
            "@/*": ["./assets/*"]
        }
    },
    "typeRoots": [
        "./assets/js/types",
        "./node_modules/@types/"
    ]
}
